# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/digital_id_card

# Auth: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=10

# Email. Use "smtp" for real delivery. "console" prints emails to the server
# log and is for local development only.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_gmail_address
SMTP_PASSWORD=your_new_app_password
SMTP_FROM_NAME=TapCard

# Reject sign-ups whose email domain has no mail servers (e.g. the typo gfmail.com)
EMAIL_DOMAIN_CHECK=true

# OTP rules
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# Public address of the frontend. Card links and QR codes use it, so set the
# real domain in production, e.g. https://tapcard.example.com
PUBLIC_APP_URL=http://localhost:5173

# "development" or "production". Leave as production on any real server.
APP_ENV=production
# Development testing only: one demo NFC activation code that runs the activation
# flow without a registered card (no physical card is activated). Ignored unless
# APP_ENV=development. Leave empty in production.
DEV_DEMO_ACTIVATION_CODE=
